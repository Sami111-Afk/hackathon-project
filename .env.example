# Copiază în .env și completează. IMPORTANT: comentariile stau pe rând separat,
# niciodată după o valoare (altfel devin parte din valoare).

# ── Mediu ──
# dev | demo | test  (demo ascunde /docs și interzice /api/admin/reset)
ENV=dev

# ── LLM ──
# bedrock | cloud | local | mock   (cloud = Featherless)
LLM_MODE=mock
# cheia TA personală Featherless
FEATHERLESS_API_KEY=
# Ollama rulează pe același laptop cu backend-ul
OLLAMA_URL=http://127.0.0.1:11434
MODEL_EXTRACT=deepseek-ai/DeepSeek-V4-Flash
MODEL_REASON=deepseek-ai/DeepSeek-V4-Flash
MODEL_VISION=Qwen/Qwen3.8-Flash-Next
# numele modelului Qwen ~4B din Ollama
MODEL_LOCAL=
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_S=30
# true = redă răspunsurile salvate (demo fără internet)
DEMO_CACHE=false
# true = salvează răspunsurile LLM în data/llm_cache (rulați o dată înainte de demo)
LLM_RECORD=false

# ── AWS Bedrock (Claude) ──
# cheia de la organizatori; EXPIRĂ după 12h → atunci trecem pe LLM_MODE=cloud
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
BEDROCK_MODEL_EXTRACT=us.anthropic.claude-haiku-5-5
BEDROCK_MODEL_REASON=us.anthropic.claude-sonnet-5-5
BEDROCK_MODEL_DEEP=us.anthropic.claude-opus-5-5

# ── Confidențialitate (obligatorii) ──
# python -c "import secrets;print(secrets.token_hex(32))"
HMAC_SECRET=
# python -c "import secrets;print(secrets.token_hex(32))"
ARENA_HMAC_SECRET=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
VAULT_KEY=
HE_ENABLED=true

# ── Detector ──
# on doar pe laptopul cu GPU
DETECTOR_GPU=off
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ── API / acces ──
# python -c "import secrets;print(secrets.token_urlsafe(24))"
BANK_UI_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# domeniul static ngrok al laptopului băncii (fără https://), folosit de scripts/start_bank.sh
NGROK_DOMAIN=
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
DATABASE_URL=sqlite:///./orb.db
VAULT_DATABASE_URL=sqlite:///./vault.db

# ── Arena ──
ARENA_RATE_LIMIT_PER_MIN=5
ARENA_MAX_FILE_MB=5

# ── Metrici (presupuneri, de confirmat cu mentorii Raiffeisen) ──
MANUAL_MINUTES_PER_CASE=20
REVIEW_MINUTES_PER_CASE=1
COST_PER_HOUR_RON=60
