{
  "$defs": {
    "Evidence": {
      "properties": {
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Id"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "LLMUsage": {
      "properties": {
        "provider": {
          "enum": [
            "featherless",
            "ollama",
            "mock",
            "cache"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "title": "Cost Usd",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "LLMUsage",
      "type": "object"
    }
  },
  "properties": {
    "agent": {
      "enum": [
        "paznic",
        "functionar",
        "verificator",
        "detector",
        "detectiv",
        "compliance"
      ],
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "done",
        "error",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "risk": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk"
    },
    "duration_ms": {
      "default": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "llm_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/LLMUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "agent",
    "status"
  ],
  "title": "AgentResult",
  "type": "object"
}
